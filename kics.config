# KICS configuration — scanned IaC: the Terraform stacks under samples/.
# Accepted findings are ignored INLINE next to the resource (`# kics-scan ignore-line` /
# `# kics-scan disable=<query-id>`) with the reason as a comment — never globally here.
fail-on:
  - high
  - critical
# Provider binaries, dependencies and scan output are not repository code
exclude-paths:
  - /path/.git
  - /path/samples/base/infra/.terraform
  - /path/samples/ecs-service/infra/.terraform
  - /path/samples/ecs-task/infra/.terraform
  - /path/samples/msk-akhq/infra/.terraform
  - /path/samples/rds-aurora-pg/infra/.terraform
  - /path/samples/rds-aurora-pg/app/lambdas/sample-rds-iam-auth/node_modules

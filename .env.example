# Copy to .env (git-ignored). Loaded by Task (`dotenv`) and picked up by Terraform through the TF_VAR_ prefix.
# Name of the S3 bucket holding the Terraform state (see `task bootstrap:s3`).
TF_VAR_state_bucket=example-terraform-state-bucket
AWS_PROFILE=default
# ACM certificate of the HTTPS listener (msk-akhq only)
TF_VAR_acm_certificate_arn=arn:aws:acm:eu-west-3:000000000000:certificate/00000000-0000-0000-0000-000000000000
